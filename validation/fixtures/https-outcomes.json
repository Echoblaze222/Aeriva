    {"id": "FIX-HTTPS-011", "description": "The portal flag alone is not enough: a plain connection refusal with the flag set stays EndpointFailure.", "l1": {"type": "ConnectFailed", "kind": "REFUSED"}, "portal_flag_start": true, "portal_flag_end": true, "expected": {"l2": "EndpointFailure", "kind": "REFUSED", "state": "UNAVAILABLE"}},
