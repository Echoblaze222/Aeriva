<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/status_indicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/status_dot"
            android:backgroundTint="@color/aeriva_unknown"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/status_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:text="@string/status_initializing_headline"
            android:textColor="@color/aeriva_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.1"
        android:text="@string/status_initializing_message"
        android:textColor="@color/aeriva_silver"
        android:textSize="15sp" />
</LinearLayout>
