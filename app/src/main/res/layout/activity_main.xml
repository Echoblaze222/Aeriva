<?xml version="1.0" encoding="utf-8"?>
<!--
  fitsSystemWindows keeps content clear of the status/navigation bars:
  targetSdk 36 enforces edge-to-edge on Android 15+.

  The cards are separate files included below, so a change to one card is a
  change to one small file. Every id inside an included file stays reachable
  with findViewById.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aeriva_black"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/brand_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:text="@string/app_name"
                android:textColor="@color/aeriva_ice_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/home_title"
                android:textColor="@color/aeriva_white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/brand_tagline"
                android:textColor="@color/aeriva_silver"
                android:textSize="14sp" />

            <include layout="@layout/view_welcome_card" />
            <include layout="@layout/view_status_card" />
            <include layout="@layout/view_advisor_card" />
            <include layout="@layout/view_networks_card" />
            <include layout="@layout/view_details_card" />
            <include layout="@layout/view_history_card" />
            <include layout="@layout/view_home_actions" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
