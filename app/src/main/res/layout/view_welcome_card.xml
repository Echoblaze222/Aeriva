<?xml version="1.0" encoding="utf-8"?>
<!--
  First run welcome. Hidden until the stored "dismissed" value is read and is
  false; dismissing stores true so it never returns.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:background="@drawable/card_background_recommend"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title"
        android:textColor="@color/aeriva_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.1"
        android:text="@string/welcome_message"
        android:textColor="@color/aeriva_silver"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/welcome_dismiss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/welcome_dismiss"
        android:textColor="@color/advisor_action_text"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
