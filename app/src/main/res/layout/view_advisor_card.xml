<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Advisor card (ADVISOR_UI_SPEC.md section 4). Hidden until the first
  candidate list arrives. Not one focus target: eyebrow, headline, message,
  basis and note are read in order and the action is its own target. No fixed
  height and no maxLines so large font scales stay readable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/advisor_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/advisor_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/advisor_card_title"
        android:textAllCaps="true"
        android:textColor="@color/advisor_eyebrow_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/advisor_indicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/status_dot"
            android:backgroundTint="@color/advisor_indicator_idle"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/advisor_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/advisor_headline_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/advisor_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/advisor_message_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/advisor_basis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/advisor_recommend_basis"
        android:textColor="@color/advisor_basis_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/advisor_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/advisor_message_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/advisor_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/advisor_recommend_action"
        android:textColor="@color/advisor_action_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/advisor_action_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:text="@string/advisor_recommend_action_failed"
        android:textColor="@color/advisor_action_error_text"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
