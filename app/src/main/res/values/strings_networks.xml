    <string name="networks_check_passed">Android\'s check passed</string>
    <string name="networks_check_not_passed">Android\'s check did not pass</string>
    <string name="networks_metered">Metered</string>
    <string name="networks_not_metered">Not metered</string>
    <string name="networks_sign_in_page">Sign-in page reported</string>
    <string name="networks_blocked">Blocked by a device policy</string>
</resources>
