<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Advisor card colors. DRAFT, not wired to any layout or code.
  Every value is an alias of an existing color in colors.xml, so this file
  adds no new hex value and cannot drift from the palette.

  Red (aeriva_offline) is deliberately not used here. The connection status
  card above already carries the offline signal, and the advisor card must
  not read as a second alarm.

  Contrast ratios for each pairing are in ADVISOR_UI_SPEC.md section 7.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">
    <!-- Status dot per card state. -->
    <color name="advisor_indicator_idle">@color/aeriva_unknown</color>
    <color name="advisor_indicator_recommend">@color/aeriva_ice_blue</color>
    <color name="advisor_indicator_single_network">@color/aeriva_unknown</color>
    <color name="advisor_indicator_no_network">@color/aeriva_unknown</color>
    <color name="advisor_indicator_insufficient">@color/aeriva_unknown</color>
    <color name="advisor_indicator_stale">@color/aeriva_warning</color>

    <!-- Text roles. -->
    <color name="advisor_eyebrow_text">@color/aeriva_silver</color>
    <color name="advisor_headline_text">@color/aeriva_white</color>
    <color name="advisor_message_text">@color/aeriva_silver</color>
    <color name="advisor_basis_text">@color/aeriva_silver</color>
    <color name="advisor_action_text">@color/aeriva_ice_blue</color>
    <color name="advisor_action_error_text">@color/aeriva_warning</color>

    <!-- Card outline when a recommendation is shown. Idle states keep the
         existing aeriva_surface_stroke through card_background. -->
    <color name="advisor_card_stroke_recommend">@color/aeriva_ice_blue</color>
</resources>
